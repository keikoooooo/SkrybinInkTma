# Telegram Bot Token (required for validating initData)
BOT_TOKEN=your_telegram_bot_token_here

# PostgreSQL Database URL
DATABASE_URL=postgres://user:password@localhost:5432/skryabin_ink?sslmode=disable

# Server Port (default: 8080)
PORT=8080

# CORS Origin (comma-separated list of allowed origins, or leave empty for all)
CORS_ORIGIN=http://localhost:5173,https://your-domain.com

# Admin Telegram IDs (comma-separated list)
# Users with these Telegram IDs will automatically get admin role
ADMIN_IDS=123456789,987654321

# Image Storage Configuration
# For local storage (development):
UPLOAD_DIR=./uploads
PUBLIC_URL=http://localhost:8080

# For Cloudinary (production - optional):
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

