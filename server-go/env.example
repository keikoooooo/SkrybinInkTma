# Telegram Bot Token (required for validating initData)
BOT_TOKEN=your_telegram_bot_token_here

# PostgreSQL Database URL
DATABASE_URL=postgres://user:password@localhost:5432/skryabin_ink?sslmode=disable

# Server Port (default: 8080)
PORT=8080

# CORS Origin (comma-separated list of allowed origins, or leave empty for all)
CORS_ORIGIN=http://localhost:5173,https://your-domain.com

